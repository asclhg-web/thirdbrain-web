# AX Platform 배치 환경값 — 실제 값은 .env(커밋 금지)와 ./secrets/* 파일로
# secrets/ 디렉터리에 파일 4개를 만들고 각 한 줄 값만 넣는다:
#   secrets/pg_password  secrets/minio_password  secrets/superset_key  secrets/kc_password
NEO4J_PASSWORD=change-me
AXP_DOMAIN=axp.example.local          # 사내 DNS
AXP_TZ=Asia/Seoul
# 반출 게이트(M0-3)가 유일하게 허용하는 외부 목적지 — 그 외 전 서비스는 internal 망
EXPORT_ALLOWED_HOSTS=api.anthropic.com
