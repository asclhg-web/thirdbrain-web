# 야간 배치 스케줄러 유닛
[Unit]
Description=AX Platform Nightly Scheduler
After=network-online.target postgresql.service

[Service]
User=axp
Group=axp
WorkingDirectory=/opt/ax-platform/core
EnvironmentFile=/etc/axp/env
ExecStart=/usr/bin/python3 -m axp.scheduler --schedule
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/axp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
