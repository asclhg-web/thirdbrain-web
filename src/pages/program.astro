---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '실천 프로그램 · 30일 몰입 & 부트캠프',
  description: '책을 읽었다면 함께하면 좋은 실천 프로그램. 서드브레인 30일 몰입 프로그램과 부트캠프 — 인터랙티브 미리보기 포함.',
};
---

<Layout metadata={metadata}>
  <!-- Hero ************************** -->

  <Hero
    actions={[
      { variant: 'primary', text: '30일 몰입 신청', href: '#apply', icon: 'tabler:flame' },
      { text: '부트캠프 문의', href: '#bootcamp' },
    ]}
    image={{ src: '~/assets/images/multiply.png', alt: '서드브레인 곱셈의 수학' }}
  >
    <Fragment slot="title">
      책을 삶으로 <br />
      <span class="text-accent dark:text-white">몸에 익힙니다</span>
    </Fragment>
    <Fragment slot="subtitle">
      서드브레인은 개념이 아니라 습관입니다. 책을 읽었다면, 함께하면 좋은 실천 프로그램 —
      30일 몰입 프로그램과 부트캠프로 몸·지식·AI를 하나로 잇는 루틴을 만듭니다.
    </Fragment>
  </Hero>

  <!-- 참여 전후 변화 (인포그래픽) ** -->

  <Content
    isReversed
    tagline="무엇이 달라지나"
    title="참여 전후, 역량의 변화"
    image={{ src: '~/assets/images/radar.png', alt: '참여 전후 역량 레이더 차트' }}
  >
    <Fragment slot="content">
      <p>
        집중·지식관리·AI활용·창의·실행 — 30일을 지나며 역량이 한쪽이 아니라
        <span class="font-semibold">전방위로</span> 확장됩니다. 막연한 다짐이 아니라, 구조화된 4주의 결과입니다.
      </p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 30일 커리큘럼 *************** -->

  <Steps
    id="thirty"
    title="30일 몰입 프로그램 — 4주 커리큘럼"
    tagline="실천 프로그램 · 30-Day Flow"
    items={[
      {
        title: '1주차 · 몸을 깨운다',
        description: '신경가소성의 원리와 뇌 최적화 루틴. 첫 번째 뇌를 단련하는 한 주.',
        icon: 'tabler:run',
      },
      {
        title: '2주차 · 지식을 쌓는다',
        description: '세컨드브레인 셋업(옵시디언·노션). CAPTURE·RETRIEVE·CONNECT를 매일 실천합니다.',
        icon: 'tabler:notebook',
      },
      {
        title: '3주차 · AI를 잇는다',
        description: 'AI 협업 워크플로 구축. 세 번째 뇌로 사고를 증폭하는 훈련.',
        icon: 'tabler:cpu',
      },
      {
        title: '4주차 · 습관으로 만든다',
        description: '루틴을 내 것으로 정착시켜, 책의 내용을 삶으로 옮깁니다.',
        icon: 'tabler:calendar-check',
      },
      { title: '서드브레인 완성!', icon: 'tabler:check' },
    ]}
    image={{ src: '~/assets/images/flow-cycle.png', alt: '몰입 사이클' }}
  />

  <!-- 인터랙티브 미리보기 ① 30일 ** -->

  <section class="px-4 py-12 sm:px-6 mx-auto max-w-5xl">
    <div class="mb-6 text-center">
      <p class="text-base text-secondary font-bold tracking-wide uppercase">실천 프로그램 · 인터랙티브 미리보기</p>
      <h2 class="text-3xl font-bold tracking-tight dark:text-white">30일 프로그램, 직접 둘러보기</h2>
      <p class="mt-2 text-muted">읽는 소개가 아니라, 만지며 미리 경험하는 30일.</p>
    </div>
    <iframe
      src="/interactive/program30.html"
      title="30일 몰입 프로그램 인터랙티브"
      loading="lazy"
      class="w-full rounded-lg border border-gray-200 dark:border-slate-700 shadow-sm"
      style="height: 640px;"></iframe>
  </section>

  <!-- 인터랙티브 ② 매일의 루프 **** -->

  <section class="px-4 py-12 sm:px-6 mx-auto max-w-5xl bg-blue-50 dark:bg-transparent rounded-xl">
    <div class="mb-6 text-center">
      <p class="text-base text-secondary font-bold tracking-wide uppercase">실천 프로그램 · 인터랙티브</p>
      <h2 class="text-3xl font-bold tracking-tight dark:text-white">매일의 증강 루프 (C.O.R.E.)</h2>
      <p class="mt-2 text-muted">하루의 루틴이 어떻게 나선처럼 쌓여 성장으로 이어지는지 살펴보세요.</p>
    </div>
    <iframe
      src="/interactive/loop.html"
      title="C.O.R.E. 나선 증강 루프"
      loading="lazy"
      class="w-full rounded-lg border border-gray-200 dark:border-slate-700 shadow-sm bg-white"
      style="height: 620px;"></iframe>
  </section>

  <!-- 인터랙티브 ③ 성찰 타임라인 ** -->

  <section class="px-4 py-12 sm:px-6 mx-auto max-w-5xl">
    <div class="mb-6 text-center">
      <p class="text-base text-secondary font-bold tracking-wide uppercase">실천 프로그램 · 인터랙티브</p>
      <h2 class="text-3xl font-bold tracking-tight dark:text-white">30일 통합 성찰 타임라인</h2>
      <p class="mt-2 text-muted">매일의 회고가 30일의 변화로 이어지는 흐름.</p>
    </div>
    <iframe
      src="/interactive/reflection.html"
      title="30일 통합 성찰 타임라인"
      loading="lazy"
      class="w-full rounded-lg border border-gray-200 dark:border-slate-700 shadow-sm bg-white"
      style="height: 640px;"></iframe>
  </section>

  <!-- 성장의 원리 (인포그래픽) **** -->

  <Content
    isAfterContent
    tagline="성장의 원리"
    title="누적이 만드는 폭발적 성장"
    image={{ src: '~/assets/images/emergence.png', alt: '창발 다이어그램' }}
  >
    <Fragment slot="content">
      <p>
        작은 실천이 매일 쌓이면, 어느 순간 <span class="font-semibold">창발(emergence)</span>이 일어납니다.
        선형의 노력이 비선형의 도약으로 바뀌는 지점 — 서드브레인이 작동하기 시작하는 순간입니다.
      </p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 가격 / 신청 ***************** -->

  <Pricing
    id="apply"
    title="프로그램 선택"
    subtitle="목표와 일정에 맞게 선택하세요. (현재 사전신청 단계입니다.)"
    prices={[
      {
        title: '서드브레인 부트캠프',
        subtitle: '집중 워크숍으로 빠르게',
        price: '사전문의',
        period: '오프라인 / 온라인',
        items: [
          { description: '핵심 개념 집중 강의' },
          { description: '세컨드브레인 셋업 실습' },
          { description: 'AI 협업 워크플로 구축' },
          { description: '소수 정예 그룹 코칭' },
        ],
        callToAction: { text: '부트캠프 문의', href: '#bootcamp' },
      },
      {
        title: '30일 몰입 프로그램',
        subtitle: '하루 한 걸음, 습관이 되는 30일',
        price: '오픈예정',
        period: '4주 온라인',
        items: [
          { description: '몸 → 지식 → AI → 습관 4주 커리큘럼' },
          { description: '매일 실천 미션과 체크리스트' },
          { description: '인터랙티브 루프·성찰 도구 제공' },
          { description: '커뮤니티 성찰 모임' },
        ],
        callToAction: { text: '30일 몰입 사전신청', href: '#apply-form' },
        hasRibbon: true,
        ribbonTitle: '추천',
      },
    ]}
  />

  <!-- 신청 폼 ******************** -->

  <Content id="apply-form" isReversed tagline="사전신청" title="지금 사전신청하세요">
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-3">30일 몰입 사전신청</h3>
      <p class="mb-5">
        프로그램이 열리면 가장 먼저 안내받고, 얼리버드 혜택을 드립니다. 아래 폼으로 신청해 주세요.
      </p>
      <!-- 런칭 시 Tally 폼 임베드 자리 -->
      <div class="rounded-lg border-2 border-dashed border-primary/40 bg-primary/5 p-6 text-center text-muted">
        📋 사전신청 폼(Tally) 자리 — 런칭 시 연결됩니다.
      </div>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 부트캠프 문의 ************** -->

  <Content id="bootcamp" title="부트캠프 문의" tagline="Bootcamp">
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-3">서드브레인 부트캠프</h3>
      <p class="mb-5">
        기업·기관·소그룹을 위한 집중 워크숍입니다. 일정과 인원에 맞춰 맞춤형으로 진행합니다.
        도입 문의는 아래로 연락 주세요.
      </p>
      <div class="rounded-lg border-2 border-dashed border-primary/40 bg-primary/5 p-6 text-center text-muted">
        📋 부트캠프 문의 폼(Tally) 자리 — 런칭 시 연결됩니다.
      </div>
    </Fragment>
  </Content>

  <!-- CTA ************************* -->

  <CallToAction
    actions={[{ variant: 'primary', text: '30일 몰입 사전신청', href: '#apply-form', icon: 'tabler:flame' }]}
  >
    <Fragment slot="title">습관이 되는 30일을 시작하세요</Fragment>
    <Fragment slot="subtitle">읽는 사람에서, 사는 사람으로.</Fragment>
  </CallToAction>
</Layout>
