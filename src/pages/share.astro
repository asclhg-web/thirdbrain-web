---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { LINKS } from '~/data/links';
import home from '~/data/home.json';

const kakaoJsKey = home.kakaoJsKey || '';

const metadata = {
  title: '함께 알리기',
  description: '서드브레인을 SNS·카카오톡·블로그로 함께 알려주세요. 포스터·QR·PDF를 자유롭게 다운로드하고 공유할 수 있습니다.',
};
---

<Layout metadata={metadata}>
  <!-- 소개 ************************* -->
  <section class="px-4 py-12 sm:px-6 mx-auto max-w-5xl text-center">
    <p class="text-base text-secondary font-bold tracking-wide uppercase">함께 알리기</p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight dark:text-white mt-2">서드브레인을 알려주세요</h1>
    <p class="mt-4 text-lg text-muted max-w-2xl mx-auto">
      포스터를 SNS·카카오톡·블로그에 공유해 주세요. QR을 스캔하거나 포스터(PDF)를 탭하면
      <span class="font-semibold">thirdbrain.kr</span>로 바로 연결됩니다.
    </p>
  </section>

  <!-- 카카오톡 홍보 카드 보내기 **** -->
  <section class="px-4 sm:px-6 mx-auto max-w-3xl pb-10">
    <div
      class="rounded-xl border border-gray-200 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40 p-6 text-center"
      data-kakao-key={kakaoJsKey}
      id="kakao-promo-root"
    >
      <h3 class="text-2xl font-bold text-accent dark:text-white">카카오톡 홍보 카드 보내기</h3>
      <p class="mt-2 text-muted">
        홍보 이미지 아래에 <span class="font-semibold">「더 알아보기」 버튼(교보문고 연결)</span>이 붙은
        카카오톡 카드 메시지를 대화방으로 바로 보냅니다.
      </p>
      <img
        src="/share/thirdbrain-promo.jpg"
        alt="서드브레인 홍보 카드 미리보기"
        class="w-full max-w-[220px] mx-auto mt-4 rounded-lg shadow border border-gray-200 dark:border-slate-700"
        loading="lazy"
      />
      <button
        type="button"
        id="kakao-promo-send"
        class="mt-5 inline-flex items-center gap-2 rounded-full bg-[#FEE500] text-[#3C1E1E] font-bold px-6 py-3 hover:brightness-95"
      >
        💬 카카오톡으로 홍보 카드 보내기
      </button>
      <p class="mt-3 text-xs text-muted">받는 분 화면: 홍보 이미지 → 제목·소개 → [더 알아보기] 버튼 → 교보문고</p>
    </div>
  </section>

  <script is:inline>
    (function () {
      function bind() {
        var root = document.getElementById('kakao-promo-root');
        var btn = document.getElementById('kakao-promo-send');
        if (!root || !btn || btn.dataset.bound) return;
        btn.dataset.bound = '1';
        var key = root.getAttribute('data-kakao-key') || '';

        function send() {
          var K = window.Kakao;
          if (!K || !K.isInitialized || !K.isInitialized()) {
            alert('카카오 SDK를 불러오지 못했습니다. 잠시 후 다시 시도해주세요.');
            return;
          }
          K.Share.sendDefault({
            objectType: 'feed',
            content: {
              title: '《서드브레인》 — AI시대, 새로운 인지시스템 탄생',
              description: '뇌과학자 서울대 의대 서유헌 명예교수 강력 추천! 몸·지식·AI를 잇는 새로운 뇌경영.',
              imageUrl: 'https://thirdbrain.kr/share/thirdbrain-promo.jpg',
              imageWidth: 800,
              imageHeight: 1203,
              link: { mobileWebUrl: 'https://thirdbrain.kr/go/kyobo', webUrl: 'https://thirdbrain.kr/go/kyobo' },
            },
            buttons: [
              {
                title: '더 알아보기',
                link: { mobileWebUrl: 'https://thirdbrain.kr/go/kyobo', webUrl: 'https://thirdbrain.kr/go/kyobo' },
              },
            ],
          });
        }

        btn.addEventListener('click', function () {
          if (window.Kakao && window.Kakao.isInitialized && window.Kakao.isInitialized()) return send();
          var s = document.createElement('script');
          s.src = 'https://t1.kakaocdn.net/kakao_js_sdk/2.7.2/kakao.min.js';
          s.crossOrigin = 'anonymous';
          s.onload = function () {
            try {
              window.Kakao.init(key);
            } catch (e) {}
            send();
          };
          s.onerror = function () {
            alert('카카오 SDK 로딩에 실패했습니다. 네트워크 상태를 확인해주세요.');
          };
          document.head.appendChild(s);
        });
      }
      bind();
      document.addEventListener('astro:after-swap', bind);
    })();
  </script>

  <!-- 포스터 2종 ****************** -->
  <section class="px-4 sm:px-6 mx-auto max-w-5xl grid md:grid-cols-2 gap-10 pb-8">
    <!-- 기본 포스터 -->
    <div class="text-center">
      <a href="/" aria-label="서드브레인 홈으로">
        <img
          src="/share/thirdbrain-poster.png"
          alt="서드브레인 포스터"
          class="w-full max-w-sm mx-auto rounded-xl shadow-lg border border-gray-200 dark:border-slate-700"
          loading="lazy"
        />
      </a>
      <h3 class="mt-5 font-bold text-xl text-accent dark:text-white">기본 포스터</h3>
      <p class="text-sm text-muted mt-1">탭하면 사이트로 연결되는 클릭형 PDF</p>
      <div class="mt-4 flex flex-wrap gap-3 justify-center">
        <a class="btn btn-primary" href="/share/thirdbrain-poster.pdf" target="_blank">PDF 열기(클릭형)</a>
        <a class="btn" href="/share/thirdbrain-poster.png" download>이미지 저장</a>
      </div>
    </div>

    <!-- QR 포스터 -->
    <div class="text-center">
      <img
        src="/share/thirdbrain-poster-qr.png"
        alt="서드브레인 포스터 (QR 코드 포함)"
        class="w-full max-w-sm mx-auto rounded-xl shadow-lg border border-gray-200 dark:border-slate-700"
        loading="lazy"
      />
      <h3 class="mt-5 font-bold text-xl text-accent dark:text-white">QR 포스터 (스캔용)</h3>
      <p class="text-sm text-muted mt-1">인스타·인쇄물에 — 스마트폰으로 스캔</p>
      <div class="mt-4 flex flex-wrap gap-3 justify-center">
        <a class="btn btn-primary" href="/share/thirdbrain-poster-qr.png" download>이미지 저장</a>
        <a class="btn" href="/share/thirdbrain-poster-qr.pdf" target="_blank">PDF 열기</a>
      </div>
    </div>
  </section>

  <!-- 공유 방법 안내 ************** -->
  <section class="px-4 sm:px-6 mx-auto max-w-3xl pb-16">
    <div class="rounded-xl border border-gray-200 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40 p-6">
      <h3 class="text-2xl font-bold text-accent dark:text-white mb-4">이렇게 공유하세요</h3>
      <ul class="space-y-3 text-muted">
        <li>💬 <span class="font-semibold">카카오톡</span> — 위 「홍보 카드 보내기」 버튼이 가장 간단합니다. PDF를 파일로 보내는 방법도 있습니다.</li>
        <li>📷 <span class="font-semibold">인스타그램 · 페이스북</span> — QR 포스터 이미지를 올리세요. 보는 분이 QR을 스캔해 접속합니다. (본문/프로필엔 <span class="font-semibold">thirdbrain.kr</span> 링크)</li>
        <li>📝 <span class="font-semibold">블로그 · 카페</span> — 포스터 이미지 + 링크(thirdbrain.kr)를 함께 올리세요.</li>
        <li>🖨️ <span class="font-semibold">인쇄물 · 명함</span> — QR 포스터를 인쇄하면 오프라인에서도 스캔으로 연결됩니다.</li>
      </ul>
      <div class="mt-5 p-4 rounded-lg bg-primary/5 text-center">
        <span class="text-sm text-muted">공유 링크</span>
        <div class="font-bold text-lg text-primary">https://thirdbrain.kr</div>
      </div>
    </div>
  </section>

  <!-- CTA ************************* -->
  <CallToAction
    actions={[
      { variant: 'primary', text: '책 구매', href: LINKS.bookk, icon: 'tabler:book' },
      { text: '홈으로', href: '/' },
    ]}
  >
    <Fragment slot="title">함께 알리면, 더 멀리 갑니다</Fragment>
    <Fragment slot="subtitle">서드브레인을 한 사람에게 더 알려주세요. 🙏</Fragment>
  </CallToAction>
</Layout>
