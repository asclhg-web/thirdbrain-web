---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { LINKS } from '~/data/links';
import home from '~/data/home.json';

const metadata = {
  title: '서드브레인 — 세 번째 뇌를 깨워라',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- ① 책이 주연 — Hero ************ -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: home.hero.primaryButton,
        href: LINKS.bookk,
        icon: 'tabler:book',
      },
      { text: '책 미리보기', href: '#book', icon: 'tabler:arrow-down' },
    ]}
    content={`<div class="mt-5 text-base font-semibold text-secondary dark:text-amber-300">${home.hero.releaseNote}</div>`}
    image={{ src: '~/assets/images/cover.jpg', alt: '서드브레인 책 표지' }}
  >
    <Fragment slot="title">
      {home.hero.titleLine1} <br />
      <span class="text-accent dark:text-white">{home.hero.titleLine2}</span>
    </Fragment>

    <Fragment slot="subtitle" set:html={home.hero.subtitle} />
  </Hero>

  <!-- Note ************************* -->

  <Note title={home.promiseTitle} description={home.promise} />

  <!-- 책이 다루는 세 개의 뇌 ******* -->

  <Features
    id="features"
    tagline="이 책이 다루는 것"
    title="「서드브레인」, 세 개의 뇌 이야기"
    subtitle="딱딱한 이론서가 아닙니다. 그림과 사례로, 세 개의 뇌를 잇는 법을 쉽게 안내합니다."
    items={[
      {
        title: '1st Brain · 몸 (1부)',
        description: '신경가소성·창의성·의식. 평생 변하는 내 뇌를 최적 상태로 단련하는 법.',
        icon: 'tabler:brain',
      },
      {
        title: '2nd Brain · 지식 (2부)',
        description: '세컨드브레인으로 기억을 외부에 쌓기. 옵시디언·노션으로 흩어진 지식을 자산으로.',
        icon: 'tabler:database',
      },
      {
        title: '3rd Brain · AI (3부)',
        description: '몸과 지식 위에 AI를 얹어 사고를 곱셈으로 확장. 세 번째 뇌가 작동하기 시작한다.',
        icon: 'tabler:cpu',
      },
      {
        title: '어려운 뇌과학을 쉽게',
        description: '전공 지식이 없어도 OK. 일상 사례와 그림으로 술술 읽힙니다.',
        icon: 'tabler:mood-smile',
      },
      {
        title: '읽고 끝나지 않는 책',
        description: '각 부 끝에 바로 쓰는 실천 도구와 도표. 읽는 책이 아니라 쓰는 책.',
        icon: 'tabler:checklist',
      },
      {
        title: '검증된 뇌과학',
        description: '대한민국 대표 뇌과학자 서유헌 교수의 추천. 자기계발 구호가 아닌 과학에서 출발.',
        icon: 'tabler:microscope',
      },
    ]}
  />

  <!-- ① 책 소개 (핵심) ************* -->

  <Content
    id="book"
    isReversed
    tagline="책 소개 · 1순위"
    title={home.book.title}
    items={[
      {
        title: '1부 · 몸경영',
        description: '인간의 뇌, 신경가소성, 뇌와 창의성, 의식·감정·예측 — 첫 번째 뇌를 깨우는 토대.',
      },
      {
        title: '2부 · 지식경영',
        description: '세컨드브레인의 탄생, CAPTURE·RETRIEVE·CONNECT, 옵시디언·노션·AI 통합.',
      },
      {
        title: '3부 · 뇌·지식·AI 융합',
        description: '서드브레인의 탄생, 몰입의 신경과학, AI와의 협업, 그리고 AI 시대의 미래.',
      },
    ]}
    image={{
      src: '~/assets/images/cover.jpg',
      alt: '서드브레인 책 표지',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">{home.book.recommendIntro}</h3>
      <ul class="mb-4 list-disc list-inside text-muted">
        {home.book.recommend.map((r) => <li>{r}</li>)}
      </ul>
      {home.book.closing}
      <div class="mt-5 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={LINKS.bookk}>📕 책 구매 (교보문고)</a>
        <a class="btn" href="/about">저자 이야기</a>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 목차 미리보기 *************** -->

  <section id="toc" class="px-4 py-12 sm:px-6 mx-auto max-w-6xl">
    <div class="mb-8 text-center">
      <p class="text-base text-secondary font-bold tracking-wide uppercase">목차 미리보기</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight dark:text-white">무엇을 읽게 되나요</h2>
      <p class="mt-2 text-muted">프롤로그부터 부록까지, 세 개의 뇌를 잇는 한 권의 흐름.</p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      <div class="p-6 rounded-xl border border-gray-200 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40">
        <h3 class="text-xl font-bold text-accent dark:text-white mb-3">1부 · 몸경영</h3>
        <ul class="space-y-1.5 text-muted text-sm list-disc list-inside">
          <li>인간의 뇌</li>
          <li>신경가소성 — 뇌는 평생 변한다</li>
          <li>뇌와 창의성</li>
          <li>의식·감정·예측</li>
        </ul>
      </div>
      <div class="p-6 rounded-xl border border-gray-200 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40">
        <h3 class="text-xl font-bold text-accent dark:text-white mb-3">2부 · 지식경영</h3>
        <ul class="space-y-1.5 text-muted text-sm list-disc list-inside">
          <li>세컨드브레인의 탄생</li>
          <li>CAPTURE · RETRIEVE · CONNECT</li>
          <li>옵시디언 · 노션 활용</li>
          <li>AI 통합</li>
        </ul>
      </div>
      <div class="p-6 rounded-xl border border-gray-200 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40">
        <h3 class="text-xl font-bold text-accent dark:text-white mb-3">3부 · 뇌·지식·AI 융합</h3>
        <ul class="space-y-1.5 text-muted text-sm list-disc list-inside">
          <li>서드브레인의 탄생</li>
          <li>몰입의 신경과학</li>
          <li>AI와의 협업</li>
          <li>AI 시대의 미래</li>
        </ul>
      </div>
    </div>
    <p class="mt-6 text-center text-sm text-muted">
      ＋ 프롤로그 · 에필로그 · <a class="underline hover:text-primary" href="/appendix">부록 — 뇌운동과 뇌영양식품</a>
    </p>
    <div class="mt-6 text-center">
      <a class="btn btn-primary" href={LINKS.bookk}>📕 책 구매 (교보문고)</a>
    </div>
  </section>

  <!-- Stats ************************ -->

  <Stats
    stats={[
      { title: '부', amount: '3' },
      { title: '핵심 개념', amount: '15+' },
      { title: '실천 도표', amount: '64' },
      { title: '추천 뇌과학자', amount: '서유헌' },
    ]}
  />

  <!-- 추천사 (구매 설득) ********** -->

  <Testimonials
    id="testimonials"
    title="먼저 읽은 분들의 이야기"
    subtitle="「서드브레인」을 만난 분들의 목소리입니다. (일부는 출간 전 추천사입니다.)"
    testimonials={[
      {
        testimonial:
          '뇌과학의 최신 통찰을 일과 삶에 연결한 보기 드문 책이다. 몸·지식·AI를 하나로 잇는 관점이 신선하다.',
        name: '서유헌 교수',
        job: '뇌과학자 · 추천사',
      },
      {
        testimonial:
          '세컨드브레인까지는 들어봤지만, 거기에 AI를 얹는 "세 번째 뇌"라는 틀이 머릿속을 정리해 주었다.',
        name: '독자 A',
        job: '지식노동자',
      },
      {
        testimonial:
          '어려울 줄 알았는데 그림과 사례 덕에 술술 읽혔다. 다 읽고 바로 옵시디언을 깔았다.',
        name: '독자 B',
        job: '직장인 독자',
      },
    ]}
  />

  <!-- ② 부록 · 실천 프로그램 ****** -->

  <Note
    title="함께하면 좋은:"
    description="책을 읽었다면, 함께하면 좋은 실천 프로그램 — 부트캠프와 30일 몰입."
  />

  <Steps
    id="program-flow"
    title="실천 ① 서드브레인이 만들어지는 30일"
    tagline="실천 프로그램"
    items={[
      {
        title: '1주차: <span class="font-medium">몸을 깨운다</span>',
        description: '신경가소성의 원리를 이해하고, 뇌를 최적 상태로 만드는 루틴을 시작합니다.',
        icon: 'tabler:run',
      },
      {
        title: '2주차: <span class="font-medium">지식을 쌓는다</span>',
        description: '세컨드브레인(옵시디언·노션)으로 흩어진 정보를 나만의 지식 자산으로 만듭니다.',
        icon: 'tabler:notebook',
      },
      {
        title: '3주차: <span class="font-medium">AI를 잇는다</span>',
        description: 'AI 협업으로 사고를 증폭합니다. 세 번째 뇌가 작동하기 시작합니다.',
        icon: 'tabler:cpu',
      },
      {
        title: '4주차: <span class="font-medium">습관으로 만든다</span>',
        description: '루틴을 내 것으로 정착시켜, 책의 내용을 삶으로 옮깁니다.',
        icon: 'tabler:calendar-check',
      },
      {
        title: '서드브레인 완성!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '~/assets/images/multiply.png',
      alt: '서드브레인 곱셈의 수학',
    }}
  />

  <Pricing
    id="pricing"
    title="실천 ② 함께하면 좋은 프로그램"
    subtitle="책으로 시작해, 프로그램으로 몸에 익히세요. (현재 사전신청 단계)"
    prices={[
      {
        title: '서드브레인 부트캠프',
        subtitle: '집중 워크숍으로 빠르게 시작',
        price: '사전문의',
        period: '오프라인 / 온라인',
        items: [
          { description: '핵심 개념 집중 강의' },
          { description: '세컨드브레인 셋업 실습' },
          { description: 'AI 협업 워크플로 구축' },
          { description: '소수 정예 그룹 코칭' },
        ],
        callToAction: { text: '부트캠프 문의', href: '/program#bootcamp' },
      },
      {
        title: '30일 몰입 프로그램',
        subtitle: '하루 한 걸음, 습관이 되는 30일',
        price: '오픈예정',
        period: '4주 온라인 프로그램',
        items: [
          { description: '몸 → 지식 → AI → 습관 4주 커리큘럼' },
          { description: '매일 실천 미션과 체크리스트' },
          { description: '커뮤니티와 함께하는 성찰' },
          { description: '책 내용을 행동으로 전환' },
        ],
        callToAction: { text: '30일 몰입 신청', href: '/program#apply' },
        hasRibbon: true,
        ribbonTitle: '추천',
      },
    ]}
  />

  <!-- ③ EEG 프로젝트 (마지막) ***** -->

  <Content
    id="eeg-preview"
    isAfterContent
    tagline="진행 중인 프로젝트"
    title="EEG로 수면과 인지를 개선한다"
    items={[
      {
        title: '수면',
        description: '뇌파로 수면의 질을 살펴, 더 잘 자고 더 잘 회복하도록 돕습니다.',
      },
      {
        title: '인지·집중',
        description: '집중과 몰입 상태를 데이터로 확인해, 인지 능력을 끌어올립니다.',
      },
    ]}
    image={{
      src: '~/assets/images/flow-eeg.png',
      alt: '몰입 3단계 뇌 인포그래픽',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">서드브레인의 다음 걸음</h3>
      EEG(뇌파)를 활용해 <span class="font-semibold">수면과 인지 개선</span>을 돕는 프로젝트를 준비하고 있습니다.
      막연한 집중이 아니라, 데이터로 보이는 변화를 향해.
      <div class="mt-5 flex flex-wrap gap-3">
        <a class="btn" href="/eeg">프로젝트 자세히</a>
        <a class="btn" href="/eeg#reserve">사전예약</a>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- FAQ ************************* -->

  <FAQs
    id="faq"
    title="자주 묻는 질문"
    subtitle="「서드브레인」과 프로그램·EEG 프로젝트에 대해 궁금한 점을 모았습니다."
    tagline="FAQ"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '서드브레인이 정확히 무엇인가요?',
        description:
          '첫 번째 뇌(몸)와 두 번째 뇌(세컨드브레인) 위에, 세 번째 뇌(AI)를 연결해 사고를 곱셈으로 확장하는 개념입니다. 책에서 쉽게 풀어 설명합니다.',
      },
      {
        title: '뇌과학을 몰라도 읽을 수 있나요?',
        description:
          '네. 전공 지식 없이도 따라올 수 있도록 그림과 사례로 쉽게 썼습니다. 옵시디언·노션·AI 활용법도 단계별로 안내합니다.',
      },
      {
        title: '책은 어디서 살 수 있나요?',
        description:
          '교보문고를 통해 구매할 수 있습니다. 상단의 "책 구매" 버튼으로 연결됩니다. 2026년 7월 10일 출간 예정입니다.',
      },
      {
        title: '프로그램(부트캠프·30일)은 꼭 들어야 하나요?',
        description:
          '아닙니다. 책만으로도 충분합니다. 프로그램은 책 내용을 함께 실천하고 싶은 분을 위한 선택 과정입니다. 현재 사전신청을 받습니다.',
      },
      {
        title: 'EEG 프로젝트는 무엇인가요?',
        description:
          '뇌파(EEG)를 활용해 수면과 인지 개선을 돕는, 서드브레인의 다음 프로젝트입니다. 현재 준비 단계로 사전예약을 받고 있습니다.',
      },
    ]}
  />

  <!-- CTA (책이 주연) ************* -->

  <CallToAction
    id="cta"
    actions={[
      {
        variant: 'primary',
        text: '책 구매',
        href: LINKS.bookk,
        icon: 'tabler:book',
      },
      {
        text: '30일 몰입 시작',
        href: '/program#apply',
        icon: 'tabler:flame',
      },
    ]}
  >
    <Fragment slot="title">세 번째 뇌, 책 한 권으로 시작하세요</Fragment>

    <Fragment slot="subtitle">
      대체되는 사람이 아니라, 대체할 수 없는 사람으로.<br class="hidden md:inline" />
      「서드브레인」과 함께 첫 걸음을.
    </Fragment>
  </CallToAction>
</Layout>
