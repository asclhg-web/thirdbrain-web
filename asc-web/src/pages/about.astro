---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '회사 소개',
};
---

<Layout metadata={metadata}>
  <!-- Hero ************************* -->

  <Hero
    actions={[
      { variant: 'primary', text: '상담 신청', href: '#contact', icon: 'tabler:mail' },
      { text: '구축 서비스', href: '/services', icon: 'tabler:tools' },
    ]}
    image={{ src: '~/assets/images/asc-logo.png', alt: 'ASC 로고 — AI System Creator' }}
  >
    <Fragment slot="title">
      (주)에이에스씨 <br />
      <span class="text-accent dark:text-white">AI System Creator</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">Odoo 파트너</span>로서 IoT·AI·RPA를 활용한 제조업 혁신 — 30년 ERP·MES·SCM
      컨설팅의 경험으로 중소기업의 업무 실행 역량을 바꾸는 지능형 시스템을 만듭니다. 방법론의 전부를
      『Odoo를 중심으로 AI ERP 혁명』으로 공개했습니다.
    </Fragment>
  </Hero>

  <!-- 파트너십·정체성 ************** -->

  <Features
    id="identity"
    tagline="에이에스씨는"
    title="세 가지 정체성"
    columns={3}
    items={[
      {
        title: 'Odoo 파트너',
        description: '오픈소스 Odoo 생태계의 공식 파트너로, 구축·커스터마이징·교육·유지보수를 제공합니다.',
        icon: 'tabler:rosette-discount-check',
      },
      {
        title: '컨설팅 회사',
        description: '3정5S·눈으로 보는 관리·DMAIC — 30년 제조 현장에서 검증된 방법론으로 진단부터 환류까지.',
        icon: 'tabler:compass',
      },
      {
        title: 'AI 기술 회사',
        description: '온톨로지-지식그래프로 암묵지를 실행하는 지식으로 — 판단하는 ERP의 기술을 보유합니다.',
        icon: 'tabler:topology-star-3',
      },
    ]}
  />

  <!-- 문제의식 ********************* -->

  <Content
    id="why"
    tagline="문제의식"
    title="스마트공장의 75%는 왜 기초 단계에서 멈추는가"
    items={[
      { title: '프로세스의 양면성', description: '정량 영역 밖에, 경험·직관·통찰이 좌우하는 활동 영역의 공백이 있습니다.' },
      { title: '암묵지의 공백', description: '기존 AI 학습 데이터로는 닿기 어려운 현장의 암묵적 지식 — 구축만으로는 채워지지 않습니다.' },
      { title: '실행력의 한계', description: '표준 프로세스가 간과하는 현장 지식 실행력 — 부분적·단기적 개선에 그치는 이유입니다.' },
    ]}
    image={{ src: '~/assets/images/odoo-architecture.jpg', alt: 'IT-지능화-OT 아키텍처' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">그래서 에이에스씨는</h3>
      기업의 암묵지를 지식그래프로 명시화하고 AI 학습으로 전환해 현장의 실행 역량을 끌어올립니다.
      암묵지 → 형식지 → 지식그래프 → AI 학습 — 이 파이프라인이 에이에스씨 방법론의 핵심입니다.
    </Fragment>
    <Fragment slot="bg"><div class="absolute inset-0 bg-primary/5 dark:bg-transparent"></div></Fragment>
  </Content>

  <!-- Stats ************************ -->

  <Stats
    stats={[
      { title: '현장 경력', amount: '30년' },
      { title: '거점', amount: '3곳' },
      { title: '출간 도서', amount: '2권' },
      { title: '핵심 플랫폼', amount: 'Odoo' },
    ]}
  />

  <!-- 거점·연락처 ****************** -->

  <section id="contact" class="px-4 py-16 sm:px-6 mx-auto max-w-5xl text-center">
    <p class="text-base text-secondary font-bold tracking-wide uppercase">상담 신청</p>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight dark:text-white mb-4">현장 이야기를 들려주세요</h2>
    <p class="text-muted mb-8">
      진단은 회의실이 아니라 창고에서 시작합니다. 귀사의 상황을 이메일로 알려주시면 가까운 거점의 컨설턴트가
      방문 상담 일정을 잡아 드립니다.
    </p>
    <div class="grid gap-5 md:grid-cols-3 text-left mb-8">
      <div class="p-6 rounded-xl border border-gray-200 dark:border-slate-700 bg-white/70 dark:bg-slate-800/40">
        <h3 class="font-bold text-lg dark:text-white mb-1">서울·경기 지사</h3>
        <p class="text-muted text-sm">서울·경기·충남권 담당 — 정인호 컨설턴트</p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200 dark:border-slate-700 bg-white/70 dark:bg-slate-800/40">
        <h3 class="font-bold text-lg dark:text-white mb-1">부산 지사</h3>
        <p class="text-muted text-sm">부산·영남권 담당 — 송무준 컨설턴트</p>
      </div>
      <div class="p-6 rounded-xl border border-gray-200 dark:border-slate-700 bg-white/70 dark:bg-slate-800/40">
        <h3 class="font-bold text-lg dark:text-white mb-1">전라 지사 (나주)</h3>
        <p class="text-muted text-sm">전라권 담당 — 이형근 대표 컨설턴트</p>
      </div>
    </div>
    <div class="p-6 rounded-xl border border-gray-200 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40 inline-block text-left">
      <p class="mb-1"><span class="font-bold">회사</span> — (주)에이에스씨 (ASC, AI System Creator)</p>
      <p class="mb-1"><span class="font-bold">대표</span> — 이형근</p>
      <p class="mb-1"><span class="font-bold">전자우편</span> — <a class="underline hover:text-primary" href="mailto:asclhg@gmail.com">asclhg@gmail.com</a></p>
      <p><span class="font-bold">홈페이지</span> — asc.kr</p>
    </div>
  </section>

  <!-- CTA ************************* -->

  <CallToAction
    actions={[
      { variant: 'primary', text: '메일로 문의하기', href: 'mailto:asclhg@gmail.com', icon: 'tabler:mail' },
      { text: '책으로 먼저 만나기', href: '/book', icon: 'tabler:book' },
    ]}
  >
    <Fragment slot="title">AI 이야기는 석 달 뒤에 하셔도 됩니다</Fragment>
    <Fragment slot="subtitle">먼저 창고와 데이터부터 — 에이에스씨의 정직한 순서로 시작하세요.</Fragment>
  </CallToAction>
</Layout>
