---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '게시판',
};

// 공지·소식 목록 — 새 글은 이 배열 맨 앞에 추가하면 됩니다.
const notices = [
  {
    category: '공지',
    title: '『AI ERP 혁명 — Odoo와 지능형 ERP』 교보문고 출간 안내',
    date: '2026-09-15',
    body: '에이에스씨의 첫 단행본이 교보문고에서 출간됩니다. 종이책(POD, 25,000원)과 전자책(PDF, 15,000원)으로 만나실 수 있습니다.',
    href: '/book',
  },
  {
    category: '공지',
    title: '에이에스씨 홈페이지(asc.kr)를 열었습니다',
    date: '2026-09-01',
    body: 'Odoo 기반 지능형 ERP, 온톨로지-지식그래프 AX 컨설팅, 그리고 책과 블로그 소식을 이곳에서 전합니다.',
    href: '/about',
  },
  {
    category: '안내',
    title: 'Odoo 기반 지능형 ERP 무료 초기 진단 상담',
    date: '2026-09-01',
    body: '전라권·서울/경기/충남권·부산/영남권 3거점에서 방문 상담을 진행합니다. 이메일로 회사 현황을 보내주시면 일정을 안내드립니다.',
    href: '/about#contact',
  },
];
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title">게시판</Fragment>
    <Fragment slot="subtitle">에이에스씨의 공지사항과 안내를 모았습니다. 문의는 게시글 하단의 이메일로 보내주세요.</Fragment>
  </Hero>

  <section class="px-4 pb-16 sm:px-6 mx-auto max-w-4xl -mt-8">
    <div class="divide-y divide-gray-200 dark:divide-slate-700 rounded-xl border border-gray-200 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40">
      {
        notices.map((n) => (
          <a href={n.href} class="block p-6 hover:bg-primary/5 transition">
            <div class="flex flex-wrap items-center gap-3 mb-1.5">
              <span class="text-xs font-bold px-2 py-0.5 rounded bg-primary/10 text-primary dark:text-blue-300">
                {n.category}
              </span>
              <span class="text-sm text-muted">{n.date}</span>
            </div>
            <h2 class="text-lg font-bold dark:text-white">{n.title}</h2>
            <p class="mt-1 text-muted text-sm">{n.body}</p>
          </a>
        ))
      }
    </div>
    <p class="mt-6 text-center text-sm text-muted">
      질문·제안은 <a class="underline hover:text-primary" href="mailto:asclhg@gmail.com">asclhg@gmail.com</a> 으로
      보내주세요. 확인 후 이 게시판과 메일로 답변드립니다.
    </p>
  </section>

  <CallToAction
    actions={[
      { variant: 'primary', text: '메일로 문의하기', href: 'mailto:asclhg@gmail.com', icon: 'tabler:mail' },
      { text: '블로그 보기', href: '/blog', icon: 'tabler:news' },
    ]}
  >
    <Fragment slot="title">궁금한 것이 있으신가요?</Fragment>
    <Fragment slot="subtitle">현장 이야기를 들려주시면, 진단의 첫 걸음부터 함께 하겠습니다.</Fragment>
  </CallToAction>
</Layout>
