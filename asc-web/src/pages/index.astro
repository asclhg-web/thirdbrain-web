---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { LINKS } from '~/data/links';

const metadata = {
  title: '에이에스씨(ASC) — Odoo 파트너 · AI System Creator',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- ① Hero — Odoo 파트너의 역량 선언 ******** -->

  <Hero
    actions={[
      { variant: 'primary', text: '상담 신청', href: '/about#contact', icon: 'tabler:mail' },
      { text: '역량 보기', href: '#capability', icon: 'tabler:arrow-down' },
    ]}
    content={`<div class="mt-5 text-base font-semibold" style="color:#714B67">Odoo Partner · 30년 ERP·MES·SCM 컨설팅 · 『AI ERP 혁명』 저자 그룹</div>`}
    image={{ src: '~/assets/images/odoo-architecture.jpg', alt: 'Odoo 중심 AI ERP 아키텍처 — IT·지능화·OT' }}
  >
    <Fragment slot="title">
      기록하는 ERP에서 <br />
      <span class="text-accent dark:text-white">판단하는 ERP로</span>
    </Fragment>

    <Fragment slot="subtitle">
      에이에스씨는 <span class="font-semibold">Odoo 파트너</span>입니다. 오픈소스 Odoo를 단일 원장의 몸체로,
      <span class="font-semibold">온톨로지-지식그래프</span>를 판단의 층위로 — 중소기업의 사각지대가 성과로
      바뀌는 지능형 ERP를 구축합니다. 그 방법의 전부를 210쪽의 책으로 공개했습니다.
    </Fragment>
  </Hero>

  <!-- ② 역량 3축 ****************************** -->

  <Features
    id="capability"
    tagline="에이에스씨의 세 가지 역량"
    title="컨설팅 × Odoo 기술 × AI 지능화"
    subtitle="세 역량은 각각 『AI ERP 혁명』의 제1부·제2부·제3부로 검증되어 있습니다."
    columns={3}
    items={[
      {
        title: '① 컨설팅 방법론',
        description:
          '3정5S와 눈으로 보는 관리를 데이터의 세계로. 현장 진단에서 환류까지 AX 5단계 로드맵 — 진단은 회의실이 아니라 창고에서 시작합니다.',
        icon: 'tabler:compass',
        callToAction: { text: '구축 서비스 →', href: '/services' },
      },
      {
        title: '② Odoo 모듈 전문성',
        description:
          '웹사이트·CRM·판매·구매·재고·제조·회계·AI까지 9개 모듈을 경영의 언어로 컨설팅합니다. 모든 모듈은 단일 원장 위의 관점입니다.',
        icon: 'tabler:stack-2',
        callToAction: { text: 'Odoo 컨설팅 →', href: '/odoo' },
      },
      {
        title: '③ AI 지능화 기술',
        description:
          'ERP가 비추지 못하는 암묵지를 온톨로지-지식그래프로 키워, 알림이 아니라 실행까지 — 다른 구축사가 멈추는 곳에서 시작하는 기술입니다.',
        icon: 'tabler:topology-star-3',
        callToAction: { text: 'AI 기술 보기 →', href: '/ai' },
      },
    ]}
  />

  <!-- ③ Odoo 모듈 맵 *************************** -->

  <Features2
    title="Odoo, 어디까지 다루는가"
    subtitle="모듈마다 '경영의 질문'으로 시작하는 컨설팅 — 각 카드의 질문에 답이 필요하다면 지금이 시작점입니다."
    tagline="Odoo 모듈 컨설팅"
    columns={3}
    items={[
      { title: '웹사이트·이커머스', description: '방문자 중 몇 명이 구매하고, 몇 명이 장바구니에서 사라지는가', icon: 'tabler:world' },
      { title: 'CRM·판매', description: '이번 달 수주는 얼마가 "진짜"로 들어오는가', icon: 'tabler:target-arrow' },
      { title: '매입(구매)', description: '그 단가는 최신인가, 발주는 왜 늦는가', icon: 'tabler:shopping-cart' },
      { title: '재고 관리', description: '지금 장부의 숫자는 진실인가', icon: 'tabler:packages' },
      { title: '제조 관리', description: '계획 대 실적은 왜 늘 어긋나는가', icon: 'tabler:building-factory-2' },
      { title: '회계', description: '영업이익이 줄어든 이유를 며칠 만에 아는가', icon: 'tabler:calculator' },
      { title: 'Odoo AI·지식센터', description: '우리 회사의 노하우는 어디에 저장되어 있는가', icon: 'tabler:message-chatbot' },
      { title: '확장 부스터', description: '플랫폼이 못 하는 것은 무엇으로 채우는가', icon: 'tabler:puzzle' },
      { title: '도입 로드맵', description: '그래서, 우리 회사는 무엇부터 시작하면 되는가', icon: 'tabler:map-2' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <div class="text-center pb-10 -mt-4">
    <a class="btn btn-primary" href="/odoo">모듈별 컨설팅 자세히 보기</a>
  </div>

  <!-- ④ 지능화 아키텍처 ************************ -->

  <Content
    id="architecture"
    isReversed
    tagline="지능화 아키텍처"
    title="IT — 지능화 — OT, 하나의 데이터 순환"
    items={[
      { title: '수요예측을 통한 영업 지능화', description: '머신러닝 수요예측이 판매계획과 생산계획으로 이어집니다.' },
      { title: '재고 최적화·생산계획 자동화', description: '안전재고와 재주문점이 데이터로 조정되고 승인으로 실행됩니다.' },
      { title: 'IoT 설비예지 지능화', description: '설비 데이터 표준화와 PLC 양방향 통신으로 고장을 미리 봅니다.' },
      { title: '노하우의 지식센터 지능화', description: '기업의 지식이 검색되고, 질문에 근거를 가지고 답합니다.' },
    ]}
    image={{ src: '~/assets/images/odoo-architecture.jpg', alt: 'IT-지능화-OT 3계층 아키텍처' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">환류가 완성입니다</h3>
      생산·품질·설비 데이터가 다시 Odoo 플랫폼으로 돌아와, 오늘의 오차가 내일의 예측을 더 정확하게 만듭니다.
      개선은 이벤트가 아니라 상시 상태 — DMAIC 루프가 데이터 위에서 스스로 돕니다.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- ⑤ 증명 ********************************** -->

  <Stats
    stats={[
      { title: '현장 컨설팅', amount: '30년' },
      { title: '컨설팅 거점', amount: '3곳' },
      { title: '방법론 공개', amount: '210쪽' },
      { title: '파트너 플랫폼', amount: 'Odoo' },
    ]}
  />

  <!-- ⑥ 책 2권 ******************************** -->

  <Note title="두 권의 책:" description="기업의 지능화와 사람의 지능화 — 에이에스씨의 방법은 책으로 공개되어 있습니다." />

  <Features
    id="books"
    columns={2}
    items={[
      {
        title: '『Odoo를 중심으로 AI ERP 혁명』 (신간)',
        description:
          '이형근·정인호·송무준 지음. 3정5S에서 온톨로지-지식그래프까지, 중소기업 지능형 ERP 구축의 전 과정을 210쪽·그림 200여 점으로. 종이책 25,000원 / 전자책 15,000원.',
        icon: 'tabler:book-2',
        callToAction: { text: '책 소개 →', href: '/book' },
      },
      {
        title: '『서드브레인 — 세 번째 뇌를 깨워라』',
        description:
          '몸·지식·AI를 하나로 잇는 뇌경영. AI 시대에 대체되지 않는 사람이 되는 법 — 뇌과학자 서유헌 교수 추천. 2026년 7월 교보문고 출간.',
        icon: 'tabler:brain',
        callToAction: { text: '책 소개 →', href: '/thirdbrain' },
      },
    ]}
  />

  <!-- ⑦ 소식 ********************************** -->

  <Note
    title="소식:"
    description="9월 15일 부산 Odoo 세미나에 에이에스씨가 협찬사로 함께합니다 · 『AI ERP 혁명』 교보문고 출간 진행 중"
  />

  <!-- ⑧ CTA *********************************** -->

  <CallToAction
    id="cta"
    actions={[
      { variant: 'primary', text: '상담 신청', href: '/about#contact', icon: 'tabler:mail' },
      { text: '책으로 먼저 검토', href: LINKS.kyobo, target: '_blank', icon: 'tabler:book' },
    ]}
  >
    <Fragment slot="title">진단은 창고에서 시작합니다</Fragment>
    <Fragment slot="subtitle">
      AI 이야기는 석 달 뒤에 하셔도 됩니다.<br class="hidden md:inline" /> 먼저 데이터의 3정5S부터 — 에이에스씨의
      정직한 순서로.
    </Fragment>
  </CallToAction>
</Layout>
