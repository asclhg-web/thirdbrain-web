---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { LINKS } from '~/data/links';

const metadata = {
  title: '에이에스씨(ASC) — AI System Creator',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero ************************* -->

  <Hero
    actions={[
      { variant: 'primary', text: 'Odoo AI ERP 보기', href: '/odoo', icon: 'tabler:cpu' },
      { text: '책 소개', href: '/book', icon: 'tabler:book' },
    ]}
    image={{ src: '~/assets/images/odoo-architecture.jpg', alt: 'Odoo 중심 AI ERP 아키텍처' }}
  >
    <Fragment slot="title">
      기록하는 ERP에서 <br />
      <span class="text-accent dark:text-white">판단하는 ERP로</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">에이에스씨(ASC, AI System Creator)</span>는 오픈소스
      <span class="font-semibold">Odoo</span>를 몸체로, <span class="font-semibold">온톨로지-지식그래프</span>를 판단의
      층위로 — 중소기업의 사각지대가 성과로 바뀌는 지능형 ERP를 구축합니다. 30년 ERP·MES·SCM 현장 컨설팅의
      결론을 시스템으로 만듭니다.
    </Fragment>
  </Hero>

  <!-- 핵심 사업 ******************** -->

  <Features
    id="services"
    tagline="사업 영역"
    title="에이에스씨가 하는 일"
    subtitle="구호가 아니라 현장에서 작동하는 AI 전환. 진단에서 환류까지 하나의 흐름으로 만듭니다."
    items={[
      {
        title: 'Odoo 기반 지능형 ERP 구축',
        description: '웹사이트·CRM·구매·재고·제조·회계까지 단일 원장 위에서. 데이터 3정5S로 시작하는 정직한 구축.',
        icon: 'tabler:database',
      },
      {
        title: '온톨로지-지식그래프 AX 컨설팅',
        description: '베테랑의 감(感)과 부서 관행 — ERP가 비추지 못하는 암묵지를 업무에 쓰는 지식으로 키웁니다.',
        icon: 'tabler:topology-star-3',
      },
      {
        title: '스마트공장 · MES · IoT',
        description: '설비 데이터 표준화, PLC 양방향 통신, 예지보전 — OT에서 IT까지 데이터가 흐르는 공장.',
        icon: 'tabler:building-factory-2',
      },
      {
        title: '수요예측 · 생산계획 지능화',
        description: 'APS·CPS와 머신러닝 예측으로 일정·비용·품질·설비를 미리 봅니다. DMAIC 무한 루프의 실장.',
        icon: 'tabler:chart-line',
      },
      {
        title: 'AI 교육과 출판',
        description: '『AI ERP 혁명 — Odoo와 지능형 ERP』 출간. 현장의 언어로 쓰는 지능형 ERP 교과서.',
        icon: 'tabler:book-2',
      },
      {
        title: '전국 3거점 컨설팅',
        description: '전라권 · 서울/경기/충남권 · 부산/영남권 — 세 명의 30년 컨설턴트가 직접 현장을 걷습니다.',
        icon: 'tabler:map-pin',
      },
    ]}
  />

  <!-- 방법론 ********************** -->

  <Note title="일하는 방식:" description="AI 이야기는 석 달 뒤에. 먼저 창고와 데이터의 3정5S부터 — 그것이 에이에스씨의 순서입니다." />

  <Steps
    id="method"
    title="진단에서 환류까지, AX 5단계"
    tagline="컨설팅 방법론"
    items={[
      {
        title: '1단계: <span class="font-medium">현장 진단</span>',
        description: '회의실이 아니라 창고에서 시작합니다. 물리 현장과 데이터를 같은 날, 같은 잣대로 진단합니다.',
        icon: 'tabler:search',
      },
      {
        title: '2단계: <span class="font-medium">데이터 3정5S</span>',
        description: '품목·거래처·BOM 기준정보의 정리·정돈·청소. 어떤 AI도 혼돈을 학습할 수는 없습니다.',
        icon: 'tabler:list-check',
      },
      {
        title: '3단계: <span class="font-medium">Odoo 단일 원장 구축</span>',
        description: '업종·규모별 시나리오로 모듈을 순서대로. 사건은 한 번 기록되고 관점으로만 다르게 조회됩니다.',
        icon: 'tabler:stack-2',
      },
      {
        title: '4단계: <span class="font-medium">지능화 — 예측과 판단</span>',
        description: '수요예측·재고 최적화·설비예지, 그리고 온톨로지-지식그래프 위의 근거 있는 답변.',
        icon: 'tabler:cpu',
      },
      {
        title: '5단계: 환류 — 데이터가 다시 플랫폼으로',
        icon: 'tabler:refresh',
      },
    ]}
    image={{ src: '~/assets/images/odoo-architecture.jpg', alt: 'IT-지능화-OT 3계층 아키텍처' }}
  />

  <!-- Stats ************************ -->

  <Stats
    stats={[
      { title: '현장 컨설팅', amount: '30년' },
      { title: '컨설턴트 거점', amount: '3곳' },
      { title: '저서', amount: '『AI ERP 혁명』' },
      { title: '플랫폼', amount: 'Odoo' },
    ]}
  />

  <!-- 책 미리보기 ****************** -->

  <Content
    id="book-preview"
    isReversed
    tagline="출간 도서"
    title="『AI ERP 혁명 — Odoo와 지능형 ERP』"
    items={[
      {
        title: '제1부 · 현장에서 플랫폼으로',
        description: '3정5S와 눈으로 보는 관리를 데이터의 세계로 — 지능형 ERP 컨설팅 방법론.',
      },
      {
        title: '제2부 · Odoo 모듈별 경영컨설팅',
        description: '웹사이트부터 회계까지, 모든 모듈을 경영의 언어로 해부.',
      },
      {
        title: '제3부 · 온톨로지로 완성하는 AX',
        description: '경영 사각지대의 암묵지를 실행하는 지식으로 — 성공사례와 첫 90일.',
      },
    ]}
    image={{ src: '~/assets/images/aierp-cover.jpg', alt: 'AI ERP 혁명 책 표지' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        에이에스씨의 30년이 한 권에
      </h3>
      이형근 · 정인호 · 송무준 세 컨설턴트가 쓴 중소기업 지능형 ERP 실행서. 신국판 210쪽, 그림·표 200여 점.
      <div class="mt-5 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/book">책 소개 자세히</a>
        <a class="btn" href={LINKS.kyobo} target="_blank">📕 책 구매 (교보문고)</a>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CTA ************************* -->

  <CallToAction
    id="cta"
    actions={[
      { variant: 'primary', text: '컨설팅 문의', href: '/about#contact', icon: 'tabler:mail' },
      { text: 'Odoo AI ERP 보기', href: '/odoo', icon: 'tabler:cpu' },
    ]}
  >
    <Fragment slot="title">서드브레인을 가진 기업이, 그렇지 않은 기업을 대체합니다</Fragment>
    <Fragment slot="subtitle">
      작게 시작하되, 온톨로지는 첫날부터.<br class="hidden md:inline" /> 에이에스씨가 첫 90일을 함께 설계합니다.
    </Fragment>
  </CallToAction>
</Layout>
