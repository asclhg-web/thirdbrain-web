---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { LINKS } from '~/data/links';

const metadata = {
  title: '『AI ERP 혁명 — Odoo와 지능형 ERP』 책 소개',
};
---

<Layout metadata={metadata}>
  <!-- ① 책이 주연 — Hero ************ -->

  <Hero
    actions={[
      { variant: 'primary', text: '책 구매 (교보문고)', href: LINKS.kyobo, target: '_blank', icon: 'tabler:book' },
      { text: '목차 미리보기', href: '#toc', icon: 'tabler:arrow-down' },
    ]}
    content={`<div class="mt-5 text-base font-semibold text-secondary dark:text-amber-300">2026년 교보문고 출간 · 종이책(POD) 25,000원 · 전자책(PDF) 15,000원</div>`}
    image={{ src: '~/assets/images/aierp-cover.jpg', alt: 'AI ERP 혁명 책 표지' }}
  >
    <Fragment slot="title">
      Odoo를 중심으로 <br />
      <span class="text-accent dark:text-white">AI ERP 혁명</span>
    </Fragment>

    <Fragment slot="subtitle">
      수십억 원짜리 ERP를 두고도 "그 주문이 어디까지 갔는지"를 전화로 묻는 공장이 여전히 많습니다. 30년
      ERP·MES·SCM 컨설턴트와 온톨로지 AX 설계자, 제조 현장 DX 전문가 —
      <span class="font-semibold">이형근 · 정인호 · 송무준</span>이 그 오래된 역설에 내놓는
      <span class="font-semibold">중소기업 지능형 ERP 실행서</span>입니다.
    </Fragment>
  </Hero>

  <!-- Note ************************* -->

  <Note
    title="이 책의 약속:"
    description="기록하는 ERP는 과거를 말하고, 판단하는 ERP는 미래를 말한다 — 그 전환의 철학·방법·도구·사례를 한 권에."
  />

  <!-- 책이 다루는 것 *************** -->

  <Features
    id="features"
    tagline="이 책이 다루는 것"
    title="세 개의 층위, 하나의 지능형 ERP"
    subtitle="이론서가 아니라 실행서입니다. 진단에서 첫 90일까지, 컨설팅 현장의 순서 그대로 안내합니다."
    items={[
      {
        title: '방법론 (제1부)',
        description: '3정5S·눈으로 보는 관리를 데이터의 세계로. DMAIC를 LLM이 상시로 돌리는 무한 루프로 재설계.',
        icon: 'tabler:compass',
      },
      {
        title: '플랫폼 (제2부)',
        description: '오픈소스 Odoo의 모듈들을 경영컨설팅의 언어로 해부. 모든 모듈은 단일 원장 위의 관점.',
        icon: 'tabler:stack-2',
      },
      {
        title: '지능 (제3부)',
        description: 'ERP가 비추지 못하는 사각지대의 암묵지를 온톨로지-지식그래프로 — 성공사례와 첫 90일 로드맵.',
        icon: 'tabler:topology-star-3',
      },
      {
        title: '네 가지 지능화',
        description: '수요예측 영업 지능화 · 재고 최적화와 생산계획 자동화 · IoT 설비예지 · 노하우의 지식센터화.',
        icon: 'tabler:sparkles',
      },
      {
        title: '그림·표 200여 점',
        description: '비전공 경영자도 따라오도록 모든 개념을 그림으로. 읽는 책이 아니라 꺼내 쓰는 책.',
        icon: 'tabler:photo',
      },
      {
        title: '정직한 한계 서술',
        description: '플랫폼의 결핍과 실패 패턴까지 그대로. 한계를 아는 도입만이 한계를 관리합니다.',
        icon: 'tabler:scale',
      },
    ]}
  />

  <!-- 목차 미리보기 *************** -->

  <section id="toc" class="px-4 py-12 sm:px-6 mx-auto max-w-6xl">
    <div class="mb-8 text-center">
      <p class="text-base text-secondary font-bold tracking-wide uppercase">목차 미리보기</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight dark:text-white">무엇을 읽게 되나요</h2>
      <p class="mt-2 text-muted">프롤로그부터 에필로그까지, 신국판 210쪽 · 21개 장.</p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      <div class="p-6 rounded-xl border border-gray-200 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40">
        <h3 class="text-xl font-bold text-accent dark:text-white mb-3">제1부 · 현장에서 플랫폼으로</h3>
        <ul class="space-y-1.5 text-muted text-sm list-disc list-inside">
          <li>ERP 50년과 지능형 ERP</li>
          <li>현장 진단과 3정5S — 데이터 품질의 원점</li>
          <li>눈으로 보는 관리에서 데이터로 보는 관리로</li>
          <li>부품전개와 일정계획 · DMAIC 데이터 루프</li>
          <li>AX 컨설팅 5단계 로드맵</li>
        </ul>
      </div>
      <div class="p-6 rounded-xl border border-gray-200 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40">
        <h3 class="text-xl font-bold text-accent dark:text-white mb-3">제2부 · Odoo 모듈별 경영컨설팅</h3>
        <ul class="space-y-1.5 text-muted text-sm list-disc list-inside">
          <li>왜 단일 플랫폼인가 — Odoo 총론</li>
          <li>웹사이트·이커머스 / CRM·판매 / 매입</li>
          <li>재고 / 제조 / 회계의 컨설팅</li>
          <li>Odoo AI·지식센터와 확장 부스터</li>
          <li>모듈 도입 우선순위와 전사 로드맵</li>
        </ul>
      </div>
      <div class="p-6 rounded-xl border border-gray-200 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40">
        <h3 class="text-xl font-bold text-accent dark:text-white mb-3">제3부 · 온톨로지로 완성하는 AX</h3>
        <ul class="space-y-1.5 text-muted text-sm list-disc list-inside">
          <li>경영 사각지대 — ERP가 보지 못하는 곳</li>
          <li>온톨로지-지식그래프 — 말이 시스템이 되는 길</li>
          <li>실행하는 온톨로지 — Agent와 Odoo 통합</li>
          <li>증명 — 성공사례와 첫 90일</li>
        </ul>
      </div>
    </div>
    <div class="mt-6 text-center">
      <a class="btn btn-primary" href={LINKS.kyobo} target="_blank">📕 책 구매 (교보문고)</a>
    </div>
  </section>

  <!-- Stats ************************ -->

  <Stats
    stats={[
      { title: '쪽', amount: '210' },
      { title: '장(章)', amount: '21' },
      { title: '그림·표', amount: '200+' },
      { title: '저자', amount: '3인' },
    ]}
  />

  <!-- 저자 소개 ******************** -->

  <Testimonials
    id="authors"
    title="세 저자, 세 갈래 길의 합류"
    subtitle="형식지의 정돈, 암묵지의 발굴, 그리고 현장의 구축 — 각자의 30년이 한 권에서 만났습니다."
    testimonials={[
      {
        testimonial:
          'ERP·MES·SCM 컨설턴트로 제조 현장의 데이터(DX)와 AX 경영을 하고 있다. LGCNS, 스마트 추진단을 거쳐 현재 에이에스씨에서 전라권 Odoo 기반 중소기업 지능형 ERP를 컨설팅하고 있다.',
        name: '이형근',
        job: '첫 번째 목소리 — 형식지의 길',
      },
      {
        testimonial:
          'ERP·MES·SCM 컨설턴트로 업무에 쓸 수 있는 지식으로 키우는 온톨로지 기반 AX 방법론을 설계·구축했다. 한국IBM, 영림원을 거쳐 현재 에이에스씨에서 서울·경기·충남권을 담당한다.',
        name: '정인호',
        job: '두 번째 목소리 — 암묵지의 길',
      },
      {
        testimonial:
          'ERP·MES·SCM 컨설턴트로 제조 현장의 전산화와 데이터(DX) 경영을 해왔다. LGCNS, 산업현장교수, 스마트공장 평가위원, AI코칭 위원을 거쳐 현재 에이에스씨에서 부산·영남권을 담당한다.',
        name: '송무준',
        job: '세 번째 목소리 — 구축하는 사람',
      },
    ]}
  />

  <!-- 판형·구매 정보 *************** -->

  <Content
    id="specs"
    isReversed
    tagline="도서 정보"
    title="판형과 구매 안내"
    items={[
      { title: '종이책 (교보 POD)', description: '신국판 152×225mm · 210쪽 · 컬러 · 정가 25,000원 · ISBN 979-11-999591-4-9' },
      { title: '전자책 (PDF)', description: '표지 포함 212쪽 · 정가 15,000원 · ISBN 979-11-999591-3-2' },
      { title: '펴낸곳', description: '에이에스씨 · 홈페이지 asc.kr · 전자우편 asclhg@gmail.com' },
    ]}
    image={{ src: '~/assets/images/odoo-architecture.jpg', alt: 'Odoo 중심 AI ERP 아키텍처' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">어느 문으로 들어가도 좋습니다</h3>
      경영자라면 제1부와 각 장의 핵심 요약부터, 실무자라면 제2부를 자기 모듈부터, 컨설턴트라면 제3부의
      방법론부터 — 어느 문으로 들어가든 같은 결론에 닿도록 설계했습니다.
      <div class="mt-5 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={LINKS.kyobo} target="_blank">📕 책 구매 (교보문고)</a>
        <a class="btn" href="/about">저자·회사 이야기</a>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- FAQ ************************* -->

  <FAQs
    id="faq"
    title="자주 묻는 질문"
    tagline="FAQ"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'ERP를 잘 몰라도 읽을 수 있나요?',
        description:
          '네. 모든 개념을 현장 사례와 그림·표 200여 점으로 풀었습니다. 각 장 끝의 핵심 요약만 따라 읽어도 전체 흐름이 잡히도록 썼습니다.',
      },
      {
        title: '어떤 회사에 필요한 책인가요?',
        description:
          'ERP 도입·교체를 검토하는 중소 제조·유통기업, 스마트공장을 기초 단계에서 고도화하려는 기업, 그리고 AI 시대의 방법론을 다시 세우려는 컨설턴트에게 권합니다.',
      },
      {
        title: 'Odoo가 처음인데 괜찮을까요?',
        description:
          '제2부가 Odoo 총론부터 모듈별 해부까지 차례로 안내합니다. 1인 이커머스부터 50인 제조기업까지 업종·규모별 도입 시나리오를 제시합니다.',
      },
      {
        title: '책은 어디서 살 수 있나요?',
        description: '교보문고에서 종이책(POD)과 전자책(PDF)으로 구매할 수 있습니다. 상단의 "책 구매" 버튼으로 연결됩니다.',
      },
      {
        title: '책 내용대로 구축을 도와주시나요?',
        description:
          '네. 에이에스씨가 전라권·수도권/충남·부산/영남 3거점에서 책의 방법론 그대로 진단-구축-지능화-환류를 컨설팅합니다. 회사 소개 페이지에서 문의해 주세요.',
      },
    ]}
  />

  <!-- CTA ************************* -->

  <CallToAction
    id="cta"
    actions={[
      { variant: 'primary', text: '책 구매 (교보문고)', href: LINKS.kyobo, target: '_blank', icon: 'tabler:book' },
      { text: '컨설팅 문의', href: '/about#contact', icon: 'tabler:mail' },
    ]}
  >
    <Fragment slot="title">AI가 기업을 대체하지 않습니다</Fragment>
    <Fragment slot="subtitle">
      서드브레인을 가진 기업이, 그렇지 않은 기업을 대체합니다.<br class="hidden md:inline" />
      이 문장을 당신 프로젝트의 첫 문장으로.
    </Fragment>
  </CallToAction>
</Layout>
