# 그래프 저장소
PB_DB=data/brain.db
# 옵시디언 실볼트 폴더 (T28) — 비면 샘플 볼트 사용. 예: C:\Users\ASC\Documents\MyVault\피지컬브레인
VAULT_PATH=
GRAPH_BACKEND=sqlite          # sqlite | neo4j(2차)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# AI 사서 (없으면 규칙 기반 폴백으로 동작)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=

# 음성 (2차 GPU 서버 — D-07·D-08 확정값)
STT_BASE_URL=http://localhost:8801/v1
STT_MODEL=Systran/faster-whisper-medium
PIPER_MODEL=                  # 예: /opt/piper/ko_KR-...-medium.onnx (비면 espeak-ng 폴백)

# 알림 (없으면 dry-run: data/outbox.log 에 기록)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_나=
TELEGRAM_CHAT_아버지=
TELEGRAM_CHAT_보호자=
